# ==============================================================================
# SEC EDGAR FILINGS MONITOR — VARIÁVEIS DE AMBIENTE (.env)
# ==============================================================================
# Configure estas variáveis para automatizar a execução via cron ou systemd
# sem precisar passar parâmetros sensíveis diretamente na linha de comando.
# ==============================================================================

# User-Agent obrigatório exigido pela política de uso da API da SEC EDGAR.
# Padrão exigido pela SEC: "NomeDaOrganizacao ContatoEmail@dominio.com"
SEC_USER_AGENT="HedgeFundSecAudit/1.0 (infra-monitor@greenwich-capital.local)"

# Webhook URL para alertas imediatos de novidades (Slack, Teams, Discord, etc.)
# SEC_WEBHOOK_URL="https://example.com/webhook/alerts"

# Formulários monitorados por padrão (separados por vírgula)
# SEC_FORMS="8-K,10-Q,10-K"

# Diretórios customizados de estado e cache (opcionais, padrão segue spec XDG)
# SEC_STATE_DIR="/var/lib/sec-edgar-monitor/state"
# SEC_CACHE_DIR="/var/cache/sec-edgar-monitor"
